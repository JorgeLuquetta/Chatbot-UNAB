# Copia este archivo a ".env" y completa los valores. NUNCA subas ".env" a git.

# --- n8n ---
# Genera una clave aleatoria larga, p. ej.: openssl rand -hex 32
N8N_ENCRYPTION_KEY=cambia-esta-clave
N8N_HOST=tu-ip-o-dominio
N8N_PROTOCOL=http
WEBHOOK_URL=http://tu-ip-o-dominio:9000/
# Usuario dueño de la interfaz de n8n (lo crea scripts/setup_n8n.py --activate)
N8N_OWNER_EMAIL=admin@ejemplo.com
N8N_OWNER_PASSWORD=cambia-esta-clave-Aa1

# --- Supabase (PostgreSQL + pgvector) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=
# Cadena de conexión: Supabase > botón "Connect" > Session pooler (puerto 5432)
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DB_SSL=require

# --- LLM y embeddings: Ollama local (gratis, sin cuenta) ---
LLM_MODEL=qwen2.5:1.5b
LLM_API_URL=http://ollama:11434/v1/chat/completions
EMBEDDINGS_PROVIDER=ollama
OLLAMA_EMBED_MODEL=granite-embedding:278m
# Validación con LLM en guardrails (vacío = solo reglas)
GUARDRAILS_LLM_URL=http://ollama:11434
GUARDRAILS_LLM_MODEL=qwen2.5:1.5b
# Ajustes de velocidad para CPU (historial enviado al LLM y largo de la respuesta)
LLM_HISTORY_MESSAGES=2
LLM_MAX_TOKENS=80
RAG_TOP_K=3
GUARDRAILS_LLM_INPUT=suspicious
# Opcional: usar OpenAI en lugar de Ollama → OPENAI_API_KEY=sk-..., LLM_API_URL=https://api.openai.com/v1/chat/completions,
# LLM_MODEL=gpt-4o-mini, EMBEDDINGS_PROVIDER=openai (y volver a ingerir los documentos)
OPENAI_API_KEY=

# --- Google Sheets (calendario) ---
# JSON de la cuenta de servicio en una sola línea (también se carga como credencial en n8n)
GOOGLE_SA_JSON=
GOOGLE_SHEET_ID=id-de-la-hoja-de-calculo
GOOGLE_SHEET_NAME="Calendario Académico"

# --- Firebase Cloud Messaging (solo con development build; Expo Go usa recordatorios locales) ---
FCM_PROJECT_ID=
