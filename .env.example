# Copia este archivo a ".env" y completa los valores. NUNCA subas ".env" a git.

# --- n8n ---
# Genera una clave aleatoria larga, p. ej.: openssl rand -hex 32
N8N_ENCRYPTION_KEY=cambia-esta-clave
N8N_HOST=tu-ip-o-dominio
N8N_PROTOCOL=http
WEBHOOK_URL=http://tu-ip-o-dominio:9000/
# Usuario dueño de la interfaz de n8n (lo crea scripts/setup_n8n.py --activate)
N8N_OWNER_EMAIL=admin@ejemplo.com
N8N_OWNER_PASSWORD=cambia-esta-clave-Aa1

# --- Supabase (PostgreSQL + pgvector) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=
# Cadena de conexión: Supabase > botón "Connect" > Session pooler (puerto 5432)
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DB_SSL=require

# --- LLM y embeddings: Ollama local (gratis, sin cuenta) ---
LLM_MODEL=unab-llm
LLM_API_URL=http://ollama:11434/v1/chat/completions
EMBEDDINGS_PROVIDER=ollama
OLLAMA_EMBED_MODEL=granite-embedding:278m
# Validación con LLM en guardrails (vacío = solo reglas)
GUARDRAILS_LLM_URL=http://ollama:11434
GUARDRAILS_LLM_MODEL=unab-llm
# Ajustes de velocidad para CPU (historial enviado al LLM y largo de la respuesta)
LLM_HISTORY_MESSAGES=2
LLM_MAX_TOKENS=300
RAG_TOP_K=3
GUARDRAILS_LLM_INPUT=suspicious
GUARDRAILS_LLM_TOPIC=on
# Agente IA (workflow 11, AI Agent + MCP): modelo que llama herramientas de forma fiable.
# Crear una vez: docker compose exec ollama sh -c 'ollama pull qwen2.5:3b && printf "FROM qwen2.5:3b
PARAMETER num_thread 2
" > /tmp/M && ollama create unab-agent -f /tmp/M'
AGENT_LLM_MODEL=unab-agent
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_CONTEXT_LENGTH=8192
# Opcional: usar OpenAI en lugar de Ollama → OPENAI_API_KEY=sk-..., LLM_API_URL=https://api.openai.com/v1/chat/completions,
# LLM_MODEL=gpt-4o-mini, EMBEDDINGS_PROVIDER=openai (y volver a ingerir los documentos)
OPENAI_API_KEY=

# --- Google Sheets (calendario) ---
# JSON de la cuenta de servicio en una sola línea (también se carga como credencial en n8n)
GOOGLE_SA_JSON=
GOOGLE_SHEET_ID=id-de-la-hoja-de-calculo
GOOGLE_SHEET_NAME="Calendario Académico"

# --- Firebase Cloud Messaging (solo con development build; Expo Go usa recordatorios locales) ---
FCM_PROJECT_ID=

# --- PostgreSQL local (docker-compose.override.yml) ---
# Con el override, usa: SUPABASE_DB_URL=postgresql://postgres:<POSTGRES_PASSWORD>@db:5432/chatbot y DB_SSL=disable
POSTGRES_PASSWORD=cambia-esta-clave

# --- Publicación sin dominio (VM con IP pública) ---
# 0.0.0.0 publica el chat web (9001), los QR (9002) y Expo (8081); 127.0.0.1 si usas un túnel de Cloudflare
WEB_BIND=127.0.0.1
EXPO_PUBLIC_URL=http://tu-ip:8081
EXPO_API_URL=http://tu-ip:9000/webhook
# Con túnel de Cloudflare: N8N_BIND y WEB_BIND en 127.0.0.1, y las URLs con los dominios del túnel, p. ej.
#   N8N_HOST=n8n.traumado.top  N8N_PROTOCOL=https  WEBHOOK_URL=https://n8n.traumado.top/  N8N_SECURE_COOKIE=true
#   EXPO_PUBLIC_URL=https://expoapp.traumado.top  EXPO_API_URL=https://n8n.traumado.top/webhook
N8N_BIND=0.0.0.0

# --- Correo (envío de noticias e informes desde el chat) ---
# Vacío = Mailpit (bandeja local de prueba en portal/correo/). Brevo (gratis, 300/día):
# SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login SMTP>  SMTP_PASSWORD=<clave SMTP>
# SMTP_FROM debe ser un remitente verificado en Brevo.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Asistente UNAB <asistente@tu-dominio.com>"

# --- Scraper: solo guarda noticias de estos dominios ---
NEWS_ALLOWED_DOMAINS=unab.edu.co
