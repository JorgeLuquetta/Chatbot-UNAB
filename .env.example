# Copia este archivo a ".env" y completa los valores. NUNCA subas ".env" a git.

# --- n8n ---
# Genera una clave aleatoria larga, p. ej.: openssl rand -hex 32
N8N_ENCRYPTION_KEY=cambia-esta-clave
N8N_HOST=tu-ip-o-dominio-ec2
N8N_PROTOCOL=http
WEBHOOK_URL=http://tu-ip-o-dominio-ec2:9000/

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=tu-service-role-key
# Cadena de conexión PostgreSQL (Supabase > Project Settings > Database > Connection string, modo "Session")
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DB_SSL=require

# --- LLM / Embeddings ---
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# --- Google Sheets (calendario) ---
# JSON de la cuenta de servicio en una sola línea (también se carga como credencial en n8n)
GOOGLE_SA_JSON={"type":"service_account",...}
GOOGLE_SHEET_ID=id-de-la-hoja-de-calculo
GOOGLE_SHEET_NAME=Calendario Académico

# --- Firebase Cloud Messaging ---
FCM_PROJECT_ID=tu-proyecto-firebase
