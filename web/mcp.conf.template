# Servidor MCP para clientes externos (Claude Desktop, OpenAI, ...): mcp.traumado.top → http://localhost:9004
# nginx reemplaza ${MCP_TOKEN} al arrancar (plantilla de la imagen oficial). Exige "Authorization: Bearer <token>".
# Las herramientas que modifican datos (ingesta, scraper) se rechazan para clientes externos (mcp-server/main.py).
server {
    listen 9004;
    server_name _;

    location = / {
        default_type text/plain;
        return 200 "Servidor MCP del Chatbot UNAB.\nEndpoint: POST /mcp (streamable HTTP) con el encabezado Authorization: Bearer <token>\n";
    }

    location /mcp {
        if ($http_authorization != "Bearer ${MCP_TOKEN}") { return 401; }
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $mcp_backend http://mcp-server:8000;
        proxy_pass $mcp_backend;
        proxy_http_version 1.1;
        proxy_set_header Host mcp-server:8000;       # host permitido por FastMCP
        proxy_set_header X-MCP-External 1;            # marca: cliente externo (solo lectura)
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        proxy_buffering off;                          # streamable HTTP / SSE
        proxy_read_timeout 300s;
    }

    location / { return 404; }
}
